# ─────────────────────────────────────────────────────────
#  TrustScan backend — .env.example
#  Copy to .env and fill in values. Every variable is optional unless noted.
# ─────────────────────────────────────────────────────────

# App
APP_ENV=development            # development | staging | production
APP_VERSION=4.2.0
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=true
HOST=0.0.0.0
PORT=8000

# REQUIRED in production — long random string.
SECRET_KEY=change-me-to-a-64-char-random-value

# CORS — comma-separated origins that may call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─────────────────────────────────────────────────────────
#  DATABASE
#  Dev default (SQLite) works out of the box.
#  For production: postgresql+asyncpg://user:pass@host:5432/trustscan
# ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./trustscan.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─────────────────────────────────────────────────────────
#  CACHE (Redis) — leave blank for in-memory fallback (dev only)
# ─────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
CACHE_SCAN_TTL=300
CACHE_REPUTATION_TTL=1800
CACHE_DNS_TTL=600
CACHE_AI_TTL=3600

# ─────────────────────────────────────────────────────────
#  RATE LIMITS (requests per minute per client IP)
# ─────────────────────────────────────────────────────────
RATE_LIMIT_SCAN_PER_MIN=30
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=120

# ─────────────────────────────────────────────────────────
#  OUTBOUND HTTP CLIENT
# ─────────────────────────────────────────────────────────
HTTP_TIMEOUT=10
HTTP_MAX_REDIRECTS=5

# ─────────────────────────────────────────────────────────
#  SCANNER SAFETY
# ─────────────────────────────────────────────────────────
BLOCK_PRIVATE_IPS=true
BLOCK_LOCALHOST=true
MAX_URL_LENGTH=2048

# ─────────────────────────────────────────────────────────
#  INTELLIGENCE PROVIDERS — all 100% free, no credit card required.
#  Any provider without a key is disabled at runtime — safe to leave blank.
# ─────────────────────────────────────────────────────────
# Google Safe Browsing (URL/domain reputation) — FREE, 10k req/day, no card
# Sign up: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# AbuseIPDB (IP abuse reputation) — FREE tier 1,000 checks/day, no card
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# IPQualityScore (IP + URL + email fraud) — FREE tier 5,000 lookups/month, no card
# https://www.ipqualityscore.com/
IPQS_API_KEY=

# ─────────────────────────────────────────────────────────
#  AI — FREE via Puter.js relay to Claude Sonnet.
#  When blank, scans still work — they use a deterministic rule-based report.
# ─────────────────────────────────────────────────────────
# Puter.js auth token (FREE, no card, no Anthropic account needed).
#   1. Sign up at https://puter.com (free)
#   2. Open DevTools → Console
#   3. Run:   puter.auth.getAuthToken()
#   4. Paste the string here.
PUTER_AUTH_TOKEN=
AI_MODEL_CLAUDE=claude-sonnet-4-5

# ─────────────────────────────────────────────────────────
#  EMAIL / SMTP (for sending OTP codes)
#  Leave blank in dev — OTPs are logged to stdout instead.
# ─────────────────────────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=TrustScan <noreply@trustscan.ai>
# SMTP_TLS=true

# ─────────────────────────────────────────────────────────
#  AUTH / SESSIONS
# ─────────────────────────────────────────────────────────
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
