# Copy to backend/.env and fill in the one required key.
#
# REQUIRED — the only key you actually need:
GOOGLE_SAFE_BROWSING_API_KEY=your_google_api_key_here

# Optional — enables real Claude-powered scam analysis via Puter.
# Without it, the backend falls back to an intelligent rule-based summary.
PUTER_AUTH_TOKEN=

# Optional — tighten CORS in production (defaults to "*" for dev).
TRUSTSCAN_CORS_ORIGINS=*
